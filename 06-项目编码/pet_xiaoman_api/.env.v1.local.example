# 本地 V1.0 发布仿真环境。复制为 .env.v1.local 后再按需修改。
# 该文件使用 MySQL，不读取本地 SQLite；支付、微信正式登录保持关闭。

ENV=production
SQLITE_FALLBACK=false

DB_HOST=mysql
DB_PORT=3306
DB_NAME=pet_xiaoman
DB_USER=petxiaoman
DB_PASS=petxiaoman_v1_local
MYSQL_ROOT_PASS=change-this-local-root-password

TOKEN_SECRET=change-this-local-token-secret-to-a-long-random-value
STAFF_TOKEN_SECRET=change-this-local-staff-secret-to-a-long-random-value

WX_LOGIN_ENABLED=false
WX_APPID=
WX_SECRET=

PAY_ENABLED=false
WX_MCH_ID=
WX_PAY_SERIAL_NO=
WX_PAY_NOTIFY_URL=
WX_PAY_PRIVATE_KEY_PATH=
WX_PAY_API_V3_KEY=
WX_PAY_PLATFORM_CERT_PATH=

SUBSCRIBE_TEMPLATE_IDS=
MAP_PROVIDER=wechat
MAP_PICKER_ENABLED=true
MAP_KEY=

# 本地种子数据：默认宠小满示例门店
DEV_STORE_SLUG=chongxiaoman
DEV_MANAGER_USER=petxiaoman
DEV_MANAGER_PASS=petxiaoman123
SUPER_ADMIN_USER=superadmin
SUPER_ADMIN_PASS=super123456
