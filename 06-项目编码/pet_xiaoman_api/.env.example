# pet_xiaoman API 本地/生产环境变量示例

# ---------- 数据库 ----------
ENV=development
SQLITE_FALLBACK=true
SQLITE_PATH=./pet_xiaoman-dev.sqlite

# ---------- C 端微信登录 ----------
# 正式体验版/线上支付需要开启微信登录，才能绑定 openid。
WX_LOGIN_ENABLED=false
WX_APPID=wx请替换为小程序AppID
WX_SECRET=请替换为小程序AppSecret
TOKEN_SECRET=请替换为随机长密钥

# ---------- 微信支付 JSAPI ----------
# 本地未接商户号时保持 false；上线支付前改 true。
PAY_ENABLED=false
WX_MCH_ID=请替换为微信支付商户号
WX_PAY_SERIAL_NO=请替换为商户API证书序列号
WX_PAY_NOTIFY_URL=https://你的域名/api/pay/notify/wechat
# 二选一：推荐使用路径，不要把私钥提交进仓库。
WX_PAY_PRIVATE_KEY_PATH=/absolute/path/apiclient_key.pem
# WX_PAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
WX_PAY_API_V3_KEY=请替换为32位APIv3密钥
# 回调验签使用微信支付平台证书，生产必须配置。
WX_PAY_PLATFORM_CERT_PATH=/absolute/path/wechatpay_platform_cert.pem

# ---------- 微信订阅消息 ----------
# 多个模板用英文逗号分隔。后端接口 /api/c/subscribe/config 会返回给小程序。
SUBSCRIBE_TEMPLATE_IDS=订单进度模板ID,服务完成模板ID

# ---------- 地图/定位 ----------
# V2.0 前保持可配置：wechat=小程序原生选点；tencent=后续腾讯地图；manual=仅手填地址。
MAP_PROVIDER=wechat
MAP_PICKER_ENABLED=true
MAP_KEY=
