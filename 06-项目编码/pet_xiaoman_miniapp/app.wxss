/* 小程序（多门店白标）· Design Token
 * 唯一事实源：04-品牌设计/pet_xiaoman_brand_kit_v1.0/02-color/chongxiaoman_色值表_v1.0.md
 * 规则：页面禁止写死色值/间距，一律引用本文件变量；需要新值先问「现有 Token 能否覆盖」。
 * 配比纪律：中性 60% / 主绿 30% / 陶土+点缀 10%；五禁忌=纯黑/冷蓝/促销红/荧光绿/紫色系。
 * 多租户：以下 --c-primary* 全套会在运行时按门店主色重算（utils/brand.js brandStyle()），
 *        故页面只能引用变量、不得写死主色，否则该门店会「一半绿一半自己色」。
 */

page {
  /* ===== 品牌色：暖松绿 ===== */
  --c-primary: #5B8C85;        /* 识别 / 操作 / 导航底 */
  --c-primary-press: #4A756E;  /* 按压 / 渐变终点 */
  --c-primary-deep: #3D5C57;   /* 文字 / 线条 / logo */
  --c-primary-light: #EEF4F3;  /* 背景块 */
  --c-primary-pale: #F5F9F8;   /* 更浅的选中底 */
  --c-primary-ghost: #F8FBFA;  /* 极浅操作区 */

  /* ===== 辅色：暖陶土（情绪刺点 ≤10%）===== */
  --c-clay: #D9A468;
  --c-clay-light: #F6EADB;     /* 纪念场景底 */

  /* ===== 中性 ===== */
  --c-paper: #FAF9F6;          /* 页面底色 60% */
  --c-paper-deep: #F4F0E8;     /* 纸感层次 */
  --c-card: #FFFFFF;
  --c-card-warm: #FFFDF8;      /* 轻暖白，避免冷白卡片 */
  --c-ink: #3B3F45;            /* 正文（禁纯黑） */
  --c-gray: #86909C;           /* 辅助文字 */
  --c-gray-light: #B9BEC6;     /* 占位 / 失效 */
  --c-border: #EAE7E1;         /* 暖调边框（随纸感底） */
  --c-divider: #F1EFEA;

  /* ===== 功能色 ===== */
  --c-error: #D54941;          /* 错误 / 取消，禁作促销 */
  --c-success: #5B8C85;        /* 善终场景：完成即松绿，不用亮绿 */
  --c-warning: #D9A468;        /* 警示复用陶土，保持色系克制 */

  /* ===== 间距（8rpx 基准）===== */
  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 24rpx;
  --sp-4: 32rpx;
  --sp-5: 40rpx;
  --sp-6: 48rpx;
  --sp-8: 64rpx;

  /* ===== 圆角 ===== */
  --r-sm: 8rpx;
  --r-md: 16rpx;
  --r-lg: 20rpx;
  --r-pill: 999rpx;

  /* ===== 字号 / 行高 ===== */
  --fs-xs: 22rpx;
  --fs-sm: 24rpx;
  --fs-base: 28rpx;
  --fs-md: 32rpx;
  --fs-lg: 36rpx;
  --fs-xl: 44rpx;
  --fs-display: 56rpx;
  --lh-body: 1.6;
  --lh-title: 1.35;

  /* ===== 阴影（暖调，用品牌深绿代替纯黑）===== */
  --sd-card: 0 2rpx 12rpx rgba(61, 92, 87, 0.05);
  --sd-raised: 0 8rpx 32rpx rgba(61, 92, 87, 0.10);
  --sd-action: 0 12rpx 28rpx rgba(61, 92, 87, 0.18);

  /* ===== 触控尺寸（无障碍：触控区 ≥ 88rpx ≈ 44px）===== */
  --h-touch: 88rpx;

  background: var(--c-paper);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: var(--fs-base);
  line-height: var(--lh-body);
  color: var(--c-ink);
  -webkit-font-smoothing: antialiased;
}

/* ===== 基础布局 ===== */
.page {
  min-height: 100vh;
  padding-bottom: var(--sp-6);
  background: var(--c-paper);
  box-sizing: border-box;
}

/* ===== 按钮 ===== */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: var(--h-touch);
  border-radius: var(--r-md);
  background: var(--c-primary);
  color: #fff;
  font-size: var(--fs-md);
  font-weight: 600;
  line-height: 1;
  box-shadow: var(--sd-action);
}
.btn-primary::after { border: none; }
.btn-primary.button-hover {
  background: var(--c-primary-press);
  transform: translateY(1rpx);
  box-shadow: 0 6rpx 18rpx rgba(61, 92, 87, 0.14);
}
.btn-primary[disabled] {
  background: #B9CFCB;
  color: rgba(255, 255, 255, 0.9);
  box-shadow: none;
}

.btn-plain {
  display: flex;
  align-items: center;
  justify-content: center;
  height: var(--h-touch);
  border-radius: var(--r-md);
  background: var(--c-card);
  color: var(--c-primary);
  border: 1rpx solid var(--c-primary);
  font-size: var(--fs-md);
  line-height: 1;
}
.btn-plain::after { border: none; }
.btn-plain.button-hover {
  background: var(--c-primary-light);
}

/* ===== 卡片 ===== */
.card {
  background: var(--c-card-warm);
  border-radius: var(--r-lg);
  padding: var(--sp-4);
  box-shadow: 0 2rpx 10rpx rgba(61, 92, 87, 0.045);
  border: 1rpx solid rgba(61, 92, 87, 0.06);
  /* 小程序默认 content-box：一旦给 .card 设了百分比宽度，
     内边距就会额外撑宽导致换行（两列网格踩过此坑）。统一改为 border-box。 */
  box-sizing: border-box;
}

/* ===== 标签 ===== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: var(--r-sm);
  font-size: var(--fs-xs);
  line-height: 1.5;
}
.tag--primary { background: var(--c-primary-light); color: var(--c-primary); }
.tag--clay { background: var(--c-clay-light); color: #A9762F; }
.tag--error { background: #FCECEB; color: var(--c-error); }
.tag--muted { background: var(--c-divider); color: var(--c-gray); }

/* ===== 图标 ===== */
.icon-sm { width: 32rpx; height: 32rpx; }
.icon-md { width: 40rpx; height: 40rpx; }
.icon-lg { width: 48rpx; height: 48rpx; }

/* ===== 状态页（加载 / 空 / 错误）===== */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-8) var(--sp-4);
  text-align: center;
}
.state--card {
  margin: var(--sp-4);
  background: var(--c-card-warm);
  border-radius: var(--r-lg);
  border: 1rpx solid var(--c-border);
}
.state__icon { width: 80rpx; height: 80rpx; opacity: 0.6; }
.state__text { font-size: var(--fs-base); color: var(--c-gray); }
.state__hint { font-size: var(--fs-sm); color: var(--c-gray-light); }

/* 骨架屏 */
.skeleton {
  background: linear-gradient(90deg, var(--c-divider) 25%, #F7F5F1 37%, var(--c-divider) 63%);
  background-size: 400% 100%;
  animation: sk 1.4s ease infinite;
  border-radius: var(--r-sm);
}
@keyframes sk {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

/* ===== 列表行（箭头导航）===== */
.row-link {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  min-height: var(--h-touch);
  padding: var(--sp-3) var(--sp-4);
  background: var(--c-card);
  border: 1rpx solid var(--c-border);
}
.row-link__label { flex: 1; font-size: var(--fs-base); color: var(--c-ink); }

/* ===== 品牌占位标（门店未上传 logo 时）=====
 * 用店名首字 + 反白描边顶位，绝不用平台或别家门店的图形标：
 * 否则新门店上线第一天，顾客看到的是另一家门店的 logo。
 * 深底场景直接用 .brandmark；浅底场景覆盖 color / border-color / background 三个值。 */
.brandmark {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 4rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #fff;
  font-weight: 600;
  line-height: 1;
  letter-spacing: 0;
}
