<!-- C000 登录 Login（Ardot 2:60 一比一复刻） -->
<view class="login" style="{{brandStyle}}">

  <view class="login__status" style="height:{{nav.navTop}}px"></view>

  <view class="login__wrap">

    <view class="login__brandrow">
      <view class="login__emblem">
        <image class="login__logo" src="/assets/ardot/splash-login/2_70-20260922_083458241.png" mode="aspectFit" />
      </view>
      <view class="login__brandname">{{theme.shopName || '宠小满'}}</view>
    </view>

    <view class="login__title">欢迎回来</view>
    <view class="login__sub">温柔守护每一次告别</view>

    <view class="login__spacer"></view>

    <button class="login__wx btn-block {{loading ? 'login__wx--busy' : ''}}"
      open-type="getPhoneNumber" bindgetphonenumber="onGetPhone" disabled="{{loading}}">
      <image class="login__wxicon" src="/assets/ardot/splash-login/2_78-20260922_083458242.png" mode="aspectFit" />
      <text class="login__wxt">{{loading ? '登录中…' : '微信授权登录'}}</text>
    </button>

    <button class="login__phone btn-block" bindtap="onPhoneLogin" disabled="{{loading}}">
      手机号登录
    </button>

    <view class="login__agree">登录即代表同意《用户协议》与《隐私政策》</view>
  </view>
</view>
