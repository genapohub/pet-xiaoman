.login {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 32rpx 56rpx;
  background:
    linear-gradient(180deg, var(--c-primary-light, #EEF4F3) 0%, #F7F8FA 42%, var(--c-card-warm, #FFFDF8) 100%);
}

.login__hero {
  position: relative;
  margin: 0 -32rpx;
  padding: 92rpx 32rpx 124rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.54) 0%, rgba(255, 255, 255, 0.16) 100%),
    linear-gradient(180deg, var(--c-primary-light) 0%, rgba(255, 253, 248, 0) 100%);
  border-bottom-left-radius: 52rpx;
  border-bottom-right-radius: 52rpx;
}

.login__brand {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login__lockup {
  width: 292rpx;
  height: 124rpx;
  object-fit: contain;
}

/* 未配 logo 时的中性占位标：浅底用描边徽章，避免和导航栏深底标识重复 */
.login__mark {
  width: 132rpx;
  height: 132rpx;
  border: 4rpx solid rgba(91, 140, 133, 0.72);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.64);
  color: var(--c-primary);
  font-size: 62rpx;
  box-shadow: 0 18rpx 42rpx rgba(61, 92, 87, 0.10);
}

.login__shop {
  max-width: 560rpx;
  margin-top: 22rpx;
  color: var(--c-primary-deep);
  font-size: 34rpx;
  font-weight: 600;
  line-height: var(--lh-title);
  text-align: center;
}

.login__slogan {
  max-width: 560rpx;
  margin-top: 10rpx;
  color: var(--c-primary);
  font-size: 25rpx;
  line-height: var(--lh-body);
  text-align: center;
}

.login__card {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  margin-top: -64rpx;
  padding: 34rpx 32rpx 30rpx;
  border: 1rpx solid rgba(61, 92, 87, 0.07);
  border-radius: 34rpx;
  background: rgba(255, 253, 248, 0.96);
  box-shadow: 0 24rpx 64rpx rgba(61, 92, 87, 0.12);
}

.login__card-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 28rpx;
}

.login__title {
  color: var(--c-ink);
  font-size: 34rpx;
  font-weight: 600;
  line-height: var(--lh-title);
}

.login__subtitle {
  margin-top: 8rpx;
  color: var(--c-gray);
  font-size: 24rpx;
  line-height: var(--lh-body);
}

.login__phone {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  border: none;
  border-radius: var(--r-pill);
  background: linear-gradient(180deg, var(--c-primary) 0%, var(--c-primary-press) 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
  box-shadow: 0 16rpx 34rpx rgba(61, 92, 87, 0.18);
}
.login__phone::after { border: none; }
.login__phone.button-hover {
  background: var(--c-primary-press);
  transform: translateY(1rpx);
}

.login__dev {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 82rpx;
  margin-top: 20rpx;
  border: 1rpx solid rgba(91, 140, 133, 0.54);
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.82);
  color: var(--c-primary);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}
.login__dev::after { border: none; }

.login__promise {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 30rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(61, 92, 87, 0.08);
}

.login__promise-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  gap: 8rpx;
  height: 58rpx;
  border-radius: var(--r-pill);
  background: var(--c-primary-pale);
  color: var(--c-primary-deep);
  font-size: 22rpx;
  font-weight: 600;
}

.login__promise-item image {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.login__promise-item text {
  white-space: nowrap;
}

.login__hint {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 26rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(238, 244, 243, 0.78);
  color: var(--c-gray);
  font-size: 21rpx;
  line-height: 1.55;
}

.login__hint image {
  width: 28rpx;
  height: 28rpx;
  margin-top: 3rpx;
  flex-shrink: 0;
  opacity: 0.82;
}
