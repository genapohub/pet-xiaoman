.page {
  padding-bottom: 120rpx; /* 给固定承诺条留位 */
}

.price-head {
  padding: var(--sp-6) var(--sp-4) var(--sp-4);
  background:
    linear-gradient(180deg, var(--c-primary) 0%, var(--c-primary-press) 100%);
  color: #fff;
  border-bottom-left-radius: 36rpx;
  border-bottom-right-radius: 36rpx;
}
.price-head__title {
  font-size: var(--fs-xl);
  font-weight: 600;
  line-height: var(--lh-title);
}
.price-head__desc {
  width: 620rpx;
  max-width: 100%;
  margin-top: var(--sp-2);
  color: rgba(255, 255, 255, 0.72);
  font-size: var(--fs-sm);
  line-height: 1.7;
}

.tabs {
  display: flex;
  margin: -20rpx var(--sp-4) 0;
  padding: 0 var(--sp-2);
  background: rgba(255, 253, 248, 0.96);
  border-radius: var(--r-lg);
  box-shadow: var(--sd-card);
}
.tab {
  position: relative;
  flex: 1;
  padding: var(--sp-3) 0 var(--sp-4);
  text-align: center;
  font-size: var(--fs-base);
  color: var(--c-gray);
}
.tab.on {
  color: var(--c-primary);
  font-weight: 600;
}
.tab.on::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: var(--sp-2);
  width: 40rpx;
  height: 6rpx;
  margin-left: -20rpx;
  border-radius: var(--r-pill);
  background: var(--c-primary);
}

.card {
  margin: var(--sp-3) var(--sp-4);
  padding: var(--sp-4);
}
.row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--sp-3);
}
.name {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--c-ink);
}
.price-wrap {
  min-width: 148rpx;
  text-align: right;
}
.price {
  color: var(--c-primary);
  font-size: 48rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
}
.price-note {
  display: block;
  margin-top: 4rpx;
  color: var(--c-gray);
  font-size: var(--fs-xs);
}
.tier {
  margin-top: var(--sp-1);
  font-size: var(--fs-sm);
  color: var(--c-gray);
}
.pick {
  margin: var(--sp-4) 0 0;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: var(--fs-sm);
  background: transparent;
  color: var(--c-primary);
  border: 1rpx solid rgba(91, 140, 133, 0.42);
  border-radius: var(--r-pill);
}
.pick::after { border: none; }
.pick.button-hover { background: var(--c-primary-light); }

.sk-line {
  height: 28rpx;
  margin-bottom: var(--sp-2);
}
.sk-line--lg { width: 55%; }
.sk-line--sm { width: 30%; margin-bottom: 0; }

.promise {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-1);
  padding: var(--sp-3);
  background: var(--c-primary);
  color: #fff;
  font-size: var(--fs-sm);
}
.promise__icon {
  width: 32rpx;
  height: 32rpx;
}
