<view class="page success-page" style="{{brandStyle}}">
  <view class="success" wx:if="{{orderNo}}">
    <view class="success__icon">
      <image src="/assets/icons/check-white.png" mode="aspectFit" />
    </view>
    <view class="success__title">预约已提交</view>
    <view class="success__desc">门店将在 30 分钟内电话确认</view>
  </view>

  <view class="card order-card" wx:if="{{orderNo}}" bindtap="copyOrderNo">
    <view>
      <view class="order-card__label">订单号</view>
      <view class="order-card__no">{{orderNo}}</view>
    </view>
    <view class="copy-pill">复制</view>
  </view>

  <view class="pay-note" wx:if="{{orderNo}}">
    <image src="/assets/icons/shield-primary.png" mode="aspectFit" />
    <text>{{payText}} · 服务完成前可在门店确认尾款</text>
  </view>

  <view class="actions" wx:if="{{orderNo}}">
    <button class="btn-primary" bindtap="viewOrder">查看订单</button>
    <button class="btn-plain" bindtap="backHome">返回首页</button>
  </view>

  <view wx:else class="state state--card">
    <image class="state__icon" src="/assets/icons/tab-order.png" mode="aspectFit" />
    <view class="state__text">没有找到预约信息</view>
    <view class="state__hint">可返回首页重新进入预约流程</view>
    <button class="btn-primary empty-action" bindtap="backHome">返回首页</button>
  </view>
</view>
