/* C011 预约 / 支付成功（对齐画布 47:342）· 1 画布 px = 2rpx */

.page { padding-bottom: 0; }

.sbody {
  display: flex;
  flex-direction: column;
  gap: 24rpx;                           /* 12px */
  padding: 0 40rpx;
  box-sizing: border-box;
}

/* ===== 结果卡（居中）===== */
.rescard {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;                           /* 8px */
  padding: 44rpx 36rpx;                 /* 上下 22px */
}
.rescard__badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;                        /* 56px */
  height: 112rpx;
  border-radius: var(--r-pill);
  background: var(--c-primary);
}
.rescard__check { width: 56rpx; height: 56rpx; }
.rescard__title {
  font-family: var(--font-serif);
  font-size: 40rpx;                     /* 20px */
  font-weight: 600;
  line-height: 1.3;
  color: var(--c-ink-strong);
  text-align: center;
}
.rescard__amount {
  font-size: 36rpx;                     /* 18px */
  font-weight: 600;
  color: var(--c-primary);
}
.rescard__no {
  font-size: 22rpx;                     /* 11px */
  line-height: 1.5;
  color: var(--c-gray);
  text-align: center;
}

/* ===== 信息卡 ===== */
.icard {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 28rpx 36rpx;
}
.icard__label {
  font-size: 26rpx;                     /* 13px */
  font-weight: 500;
  line-height: 1.4;
  color: var(--c-gray-mid);
}
.icard__note {
  font-size: 24rpx;                     /* 12px */
  line-height: 1.6;
  color: var(--c-gray-mid);
}
.irow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.irow__l {
  flex: none;
  font-size: 26rpx;
  color: var(--c-gray-mid);
}
.irow__v {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.4;
  color: var(--c-ink);
  text-align: right;
}

/* 给固定条让位 */
.sspacer { height: 200rpx; }
