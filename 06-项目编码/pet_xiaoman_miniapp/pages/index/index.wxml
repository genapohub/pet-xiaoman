<view class="page" style="{{brandStyle}}">
  <!-- hero：门店主色底 + 反白标；门店有自定义 logo 用图，没有则用店名首字占位 -->
  <view class="hero">
    <view class="hero__eyebrow">本地宠物善终服务</view>
    <image wx:if="{{theme.logoUrl}}" class="hero__logo" src="{{theme.logoUrl}}" mode="aspectFit" />
    <view wx:else class="hero__logo hero__mark brandmark">{{shopInitial}}</view>
    <view class="hero__name">{{theme.shopName}}</view>
    <view class="hero__slogan" wx:if="{{theme.slogan}}">{{theme.slogan}}</view>
    <view class="hero__proof">价格公开 · 过程可见 · 24小时可约</view>
  </view>

  <!-- 三承诺：上浮卡片压住 hero 底边，去图标、纯文字（spec §9.2），首卡 1.2 宽形成非对称节奏 -->
  <view class="promises">
    <view class="promise" wx:for="{{promises}}" wx:key="text">
      <view class="promise__text">{{item.text}}</view>
    </view>
  </view>

  <view class="actions">
    <button class="btn-primary" bindtap="goCreate">立即预约</button>
    <button class="btn-plain" bindtap="goPrices">查看服务价格表</button>
  </view>

  <view class="contact row-link" bindtap="callShop">
    <image class="icon-md" src="/assets/icons/phone.png" mode="aspectFit" />
    <view class="row-link__label">24 小时电话咨询</view>
    <image class="icon-sm" src="/assets/icons/chevron.png" mode="aspectFit" />
  </view>

  <view class="trust-strip">明码标价 · 单独火化 · 下单后不加价</view>
</view>
