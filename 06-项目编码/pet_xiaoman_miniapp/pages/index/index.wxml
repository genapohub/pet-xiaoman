<!-- C001 首页（对齐画布 2:84）
     结构：沉浸式 Hero 轮播（3 屏）→ 三承诺 → 服务宫格 → 今日寄语 → 门店信息。
     首页无页头——Hero 本身就是顶部，故只垫出状态栏高度；品牌名/标语走 theme，保证多门店换肤。 -->
<view class="page" style="{{brandStyle}}">

  <!-- 状态栏占位：首页 Hero 直接顶到状态栏下方（画布 Status Bar 44px = 纸感底） -->
  <view class="home-status" style="height:{{nav.navTop}}px"></view>

  <!-- ===== Hero 轮播 ===== -->
  <view class="hero">
    <swiper
      class="hero__swiper"
      circular
      autoplay="{{heroes.length > 1}}"
      interval="4800"
      duration="420"
      current="{{heroIndex}}"
      bindchange="onHeroChange"
    >
      <swiper-item wx:for="{{heroes}}" wx:key="key">
        <view class="slide slide--{{item.key}}">
          <view class="slide__body">
            <view wx:if="{{item.eyebrow}}" class="slide__eyebrow">{{item.eyebrow}}</view>
            <view wx:if="{{item.brand}}" class="slide__brand">{{item.brand}}</view>
            <view class="slide__title">{{item.title}}</view>
            <view class="slide__slogan">{{item.slogan}}</view>
          </view>
          <!-- 品牌标：有 logo 用图，没有则店名首字占位（中性兜底，绝不显示别家门店图形标） -->
          <view class="slide__emblem">
            <image wx:if="{{theme.logoUrl}}" class="slide__logo" src="{{theme.logoUrl}}" mode="aspectFit" />
            <view wx:else class="slide__mark">{{shopInitial}}</view>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <view class="hero__dots">
      <view class="dot {{item.dotClass}}" wx:for="{{heroes}}" wx:key="key"></view>
    </view>
  </view>

  <view class="home-body">

    <!-- ===== 三承诺（等宽卡片，和画布保持一致的稳定节奏）===== -->
    <view class="promises">
      <view class="promise" wx:for="{{promises}}" wx:key="key">
        <image class="promise__ic" src="{{item.icon}}" mode="aspectFit" />
        <view class="promise__t">{{item.title}}</view>
        <view class="promise__d">{{item.desc}}</view>
      </view>
    </view>

    <!-- ===== 服务宫格（2 列）===== -->
    <view class="grid">
      <view class="gcard" wx:for="{{entries}}" wx:key="key" data-idx="{{index}}" bindtap="goEntry" hover-class="gcard--hover">
        <image class="gcard__ic" src="{{item.icon}}" mode="aspectFit" />
        <view class="gcard__t">{{item.title}}</view>
        <view class="gcard__s">{{item.desc}}</view>
      </view>
    </view>

    <!-- ===== 今日寄语 ===== -->
    <view class="quote">
      <view class="quote__label">今 日 寄 语</view>
      <view class="quote__text">它们只是先去看了看远方</view>
      <view class="quote__sub">我们在这里，陪你慢慢说再见</view>
    </view>

    <!-- ===== 门店信息（信息架构 V2.0 §3 要求的「电话直呼」入口；画布未画，随卡片同源样式）===== -->
    <view class="store">
      <view class="store__row" bindtap="callShop" hover-class="store__row--hover">
        <image class="store__ic" src="{{storeIcons.phone}}" mode="aspectFit" />
        <view class="store__label">
          <view class="store__t">24 小时电话咨询</view>
        <view class="store__meta">{{theme.contactPhone || '0371-8888 6666'}}</view>
        </view>
        <image class="store__chev" src="{{storeIcons.chevron}}" mode="aspectFit" />
      </view>
      <view class="store__row" bindtap="copyAddress" hover-class="store__row--hover">
        <image class="store__ic" src="{{storeIcons.address}}" mode="aspectFit" />
        <view class="store__label">
          <view class="store__t">门店地址</view>
          <view class="store__meta">{{theme.contactAddress || '郑州市金水区花园路 88 号'}}</view>
        </view>
        <image class="store__chev" src="{{storeIcons.chevron}}" mode="aspectFit" />
      </view>
      <view class="store__row store__row--last">
        <image class="store__ic" src="{{storeIcons.clock}}" mode="aspectFit" />
        <view class="store__label">
          <view class="store__t">营业时间</view>
          <view class="store__meta">{{theme.businessHours || '09:00 - 21:00'}}</view>
        </view>
      </view>
    </view>

    <view class="trust">明码标价 · 单独火化 · 下单后不加价</view>
  </view>

  <!-- 给自定义胶囊 tabBar 让位（画布 Bottom Spacer 90px） -->
  <view class="home-spacer"></view>
</view>
