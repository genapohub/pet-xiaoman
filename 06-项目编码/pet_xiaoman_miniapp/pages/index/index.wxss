.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--sp-6) var(--sp-4) 96rpx;
  background:
    radial-gradient(circle at 18% 0%, rgba(217, 164, 104, 0.18) 0, rgba(217, 164, 104, 0) 190rpx),
    linear-gradient(180deg, var(--c-primary) 0%, var(--c-primary-press) 100%);
  border-bottom-left-radius: 42rpx;
  border-bottom-right-radius: 42rpx;
}
.hero__eyebrow {
  padding: 8rpx 18rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: var(--fs-xs);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: var(--r-pill);
}
.hero__logo {
  width: 124rpx;
  height: 124rpx;
  margin-top: var(--sp-5);
}
.hero__name {
  margin-top: var(--sp-3);
  color: #fff;
  font-size: var(--fs-display);
  font-weight: 600;
  letter-spacing: 0;
  line-height: 1.1;
}
.hero__slogan {
  margin-top: var(--sp-1);
  color: rgba(255, 255, 255, 0.64);
  font-size: var(--fs-sm);
  letter-spacing: 2rpx;
}
.hero__proof {
  margin-top: var(--sp-4);
  color: rgba(255, 255, 255, 0.88);
  font-size: var(--fs-sm);
}

/* 承诺条上浮，压住 hero 底边，避免「两块色块硬拼」 */
.promises {
  position: relative;
  z-index: 1;
  display: flex;
  gap: var(--sp-2);
  margin-top: -56rpx;
  padding: 0 var(--sp-4);
}
.promise {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-1);
  padding: var(--sp-4) 0;
  background: rgba(255, 253, 248, 0.96);
  border-radius: var(--r-lg);
  box-shadow: var(--sd-card);
  border: 1rpx solid rgba(61, 92, 87, 0.06);
}
.promise:first-child { flex: 1.2; }
.promise__text {
  font-size: var(--fs-xs);
  color: var(--c-ink);
  font-weight: 600;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  padding: var(--sp-6) var(--sp-4) 0;
}

.contact {
  margin: var(--sp-6) var(--sp-4) 0;
  border-radius: var(--r-lg);
  box-shadow: var(--sd-card);
  border: 1rpx solid rgba(61, 92, 87, 0.06);
}

.trust-strip {
  margin: var(--sp-4) var(--sp-4) 0;
  padding: var(--sp-3);
  color: #fff;
  font-size: var(--fs-sm);
  text-align: center;
  background: var(--c-primary-deep);
  border-radius: var(--r-lg);
  box-shadow: 0 8rpx 28rpx rgba(61, 92, 87, 0.12);
}
