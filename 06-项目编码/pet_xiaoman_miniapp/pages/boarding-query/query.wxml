<view class="page">
  <view class="query-head">
    <view class="query-head__title">骨灰寄存查询</view>
    <view class="query-head__desc">输入预留手机号后四位，查看寄存位置和到期时间。</view>
  </view>

  <view class="card">
    <view class="label">
      <image class="label__icon" src="/assets/icons/box-primary.png" mode="aspectFit" />
      <text>输入寄存时预留的手机号后四位</text>
    </view>
    <input type="number" maxlength="4" placeholder="后四位" value="{{tail}}" bindinput="onInput" />
    <button class="btn-primary query" bindtap="query">查询</button>
  </view>

  <view class="card" wx:for="{{result || []}}" wx:key="location">
    <view class="row"><text class="k">宠物</text><text class="v">{{item.pet_name}}</text></view>
    <view class="row"><text class="k">位置</text><text class="v">{{item.location}}</text></view>
    <view class="row"><text class="k">到期日</text><text class="v">{{item.expire_date}}</text></view>
    <view class="status-pill">{{item.severity}} · 剩 {{item.days_left}} 天</view>
  </view>

  <view wx:if="{{searched && (!result || !result.length)}}" class="state state--card">
    <image class="state__icon" src="/assets/icons/box.png" mode="aspectFit" />
    <view class="state__text">{{error || "没有查询到寄存记录"}}</view>
    <view class="state__hint">确认手机号后四位是否正确，或直接联系门店</view>
  </view>
</view>
