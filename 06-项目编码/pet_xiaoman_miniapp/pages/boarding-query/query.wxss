/* C008 骨灰寄存查询（对齐画布 2:512）· 1 画布 px = 2rpx */

.sbody {
  display: flex;
  flex-direction: column;
  gap: 32rpx;                           /* 16px */
  padding: 0 40rpx var(--sp-6);
  box-sizing: border-box;
}

/* ===== 查询卡 ===== */
.qcard {
  display: flex;
  flex-direction: column;
  gap: 24rpx;                           /* 12px */
}
.qcard__t {
  font-size: 28rpx;                     /* 14px */
  font-weight: 600;
  line-height: 1.4;
  color: var(--c-ink-strong);
}
/* 输入框：纸感底 + 12rpx 圆角（画布 input）
   注意小程序 input 默认不继承 box-sizing，必须显式 border-box 否则左右撑破卡片 */
.qcard__input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;                        /* 44px 触控下限 */
  padding: 0 28rpx;
  border-radius: 24rpx;                 /* 12px */
  background: var(--c-paper);
  font-size: 28rpx;
  color: var(--c-ink);
}
.qcard__ph { color: var(--c-gray-light); }
.qcard__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--r-pill);
  background: var(--c-primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1;
}
.qcard__btn--hover { background: var(--c-primary-press); }
.qcard__btn--busy { background: var(--c-primary-disabled); }

/* ===== 结果卡 ===== */
.rcard {
  display: flex;
  flex-direction: column;
  gap: 28rpx;                           /* 14px */
}
.rcard__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.rcard__pet {
  flex: 1;
  min-width: 0;
  font-family: var(--font-serif);
  font-size: 32rpx;                     /* 16px */
  font-weight: 600;
  line-height: 1.35;
  color: var(--c-ink-strong);
}
.rcard__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.rcard__l {
  flex: none;
  font-size: 26rpx;
  color: var(--c-gray-mid);
}
.rcard__v {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.4;
  color: var(--c-ink);
  text-align: right;
}
.rcard__note {
  font-size: 24rpx;                     /* 12px */
  line-height: 1.5;
  color: var(--c-gray-mid);
}
/* 续期 = 次要动作 → 描边 ghost；整行宽（与画布一致，卡片内唯一动作） */
.rcard__renew {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: var(--r-pill);
  background: var(--c-card);
  border: 1rpx solid var(--c-primary);
  color: var(--c-primary);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1;
}
.rcard__renew--hover { background: var(--c-primary-light); }

.scard-tip {
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--c-gray-light);
  text-align: center;
}
