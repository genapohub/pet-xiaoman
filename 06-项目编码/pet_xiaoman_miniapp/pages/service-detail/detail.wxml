<!-- C003 服务详情（对齐 Ardot 81:1）
     结构：返回 + 服务详情 → 主套餐卡 → 服务流程 → 服务包含 → 适用情况 → 安心承诺 → 底部预约按钮。 -->
<view class="page sd-page" style="{{brandStyle}}">

  <view class="nav nav--sub sd-nav" style="padding-top:{{nav.navTop}}px">
    <view class="nav__head" style="min-height:{{nav.headerH}}px">
      <view class="nav__back" bindtap="goBack" hover-class="nav__back--hover">
        <view class="nav__back-ic"></view>
      </view>
      <view class="nav__titles">
        <view class="nav__title">服务详情</view>
      </view>
    </view>
  </view>

  <block wx:if="{{loading}}">
    <view class="sdbody">
      <view class="skeleton sk-a"></view>
      <view class="skeleton sk-b"></view>
      <view class="skeleton sk-c"></view>
    </view>
  </block>

  <block wx:else>
    <view class="sdbody">
      <view class="card sd-hero">
        <view class="sd-hero__title">{{item.name || '基础告别套餐'}}</view>
        <view class="sd-hero__desc">{{item.weight_tier || fallbackItem.weight_tier}}</view>
        <view class="sd-hero__price num">¥{{item.priceText}}<text wx:if="{{item.priceText !== '800 起'}}"> 起</text></view>
        <view class="sd-tags">
          <view class="sd-tag" wx:for="{{tags}}" wx:key="*this">{{item}}</view>
        </view>
      </view>

      <view class="card sd-card">
        <view class="sd-card__title">服务流程</view>
        <view class="sd-flow" wx:for="{{flowRows}}" wx:key="*this">{{item}}</view>
      </view>

      <view class="card sd-card">
        <view class="sd-card__title">服务包含</view>
        <view class="sd-include">
          <view class="sd-include__item" wx:for="{{includeRows}}" wx:key="*this">{{item}}</view>
        </view>
      </view>

      <view class="card sd-card">
        <view class="sd-card__title">适用情况</view>
        <view class="sd-copy">{{sceneText}}</view>
      </view>

      <view class="sd-promise">
        <view class="sd-promise__title">安心承诺</view>
        <view class="sd-promise__text">{{promiseText}}</view>
      </view>

      <view class="sd-submit" bindtap="goCreate" hover-class="sd-submit--hover">预约这个服务</view>
    </view>
  </block>
</view>
