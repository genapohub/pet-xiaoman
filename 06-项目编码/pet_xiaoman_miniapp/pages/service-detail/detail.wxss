.page {
  padding-bottom: 168rpx;
}

.detail-head {
  padding: var(--sp-6) var(--sp-4) 88rpx;
  color: #fff;
  background: var(--c-primary);
  border-bottom-left-radius: 36rpx;
  border-bottom-right-radius: 36rpx;
}
.detail-head__type {
  display: inline-flex;
  padding: 6rpx 18rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: var(--fs-xs);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: var(--r-pill);
}
.detail-head__name {
  margin-top: var(--sp-3);
  font-size: var(--fs-xl);
  font-weight: 600;
  line-height: var(--lh-title);
}
.detail-head__price {
  margin-top: var(--sp-2);
  font-size: 56rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.detail-head__meta {
  margin-top: var(--sp-1);
  color: rgba(255, 255, 255, 0.72);
  font-size: var(--fs-sm);
}

.card {
  margin: var(--sp-3) var(--sp-4);
  padding: var(--sp-4);
  border: 1rpx solid var(--c-border);
}
.detail-head + .card {
  margin-top: -44rpx;
}
.section-title {
  margin-bottom: var(--sp-3);
  color: var(--c-ink);
  font-size: var(--fs-base);
  font-weight: 600;
}
.step {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  padding: var(--sp-2) 0;
}
.step__no {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  color: #fff;
  background: var(--c-primary);
  border-radius: 50%;
  font-size: var(--fs-xs);
  font-weight: 600;
}
.step__name {
  color: var(--c-ink);
  font-size: var(--fs-base);
}
.faq {
  padding: var(--sp-3) 0;
  border-top: 1rpx solid var(--c-divider);
}
.faq:first-of-type {
  border-top: none;
  padding-top: 0;
}
.faq__q {
  color: var(--c-ink);
  font-size: var(--fs-base);
  font-weight: 600;
}
.faq__a {
  margin-top: var(--sp-1);
  color: var(--c-gray);
  font-size: var(--fs-sm);
  line-height: var(--lh-body);
}
.notice {
  display: flex;
  gap: var(--sp-1);
  margin: var(--sp-3) var(--sp-4);
  padding: var(--sp-3);
  color: #A9762F;
  background: var(--c-clay-light);
  border-radius: var(--r-md);
  font-size: var(--fs-sm);
  line-height: var(--lh-body);
}
.notice__icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.detail-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--sp-2);
  padding: var(--sp-3) var(--sp-4) calc(var(--sp-3) + env(safe-area-inset-bottom));
  background: rgba(255, 253, 248, 0.98);
  border-top: 1rpx solid rgba(61, 92, 87, 0.08);
  box-shadow: 0 -8rpx 28rpx rgba(61, 92, 87, 0.08);
}
.state__btn {
  margin-top: var(--sp-3);
}
