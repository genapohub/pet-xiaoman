/* C003 服务详情 + 科普（服务 · 二级页；对齐画布 81:1）· 1 画布 px = 2rpx */

.page { padding-bottom: 0; }

.sdbody {
  display: flex;
  flex-direction: column;
  gap: 24rpx;                           /* 12px */
  padding: 0 40rpx;
  box-sizing: border-box;
}

/* ===== 价格卡 ===== */
.pcard {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 32rpx 36rpx;
}
.pcard__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.pcard__l {
  flex: none;
  font-size: 28rpx;
  color: var(--c-gray-mid);
}
.pcard__p {
  flex: none;
  font-size: 56rpx;                     /* 28px：详情页价格是主角 */
  font-weight: 600;
  line-height: 1.1;
  color: var(--c-primary);
}
.pcard__note {
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--c-gray-light);
}

/* ===== 服务内容 ===== */
.ccard,
.fcard {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 32rpx 36rpx;
}
.crow {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.crow__dot {
  flex: none;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--c-primary);
  opacity: 0.7;
}
.crow__t {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--c-ink);
}

/* ===== 常见问题 ===== */
.faq {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.faq__q {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.45;
  color: var(--c-ink-strong);
}
.faq__a {
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--c-gray-mid);
}

/* 骨架 */
.sk-a { height: 160rpx; border-radius: 36rpx; }
.sk-b { height: 240rpx; border-radius: 36rpx; }

/* 给固定底栏让位 */
.sdspacer { height: 220rpx; }
