/* C003 服务详情（对齐 Ardot 81:1）· 1 画布 px = 2rpx */

.sd-page {
  padding-bottom: 72rpx;
  background: var(--c-paper);
}

.sd-nav .nav__head {
  min-height: 112rpx;
}

.sdbody {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.sd-hero,
.sd-card {
  border-radius: 40rpx;
  border-color: #E9E0D3;
  box-shadow: var(--sd-card);
}

.sd-hero {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 36rpx;
}
.sd-hero__title {
  font-family: var(--font-serif);
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--c-ink-strong);
}
.sd-hero__desc {
  font-size: 28rpx;
  line-height: 1.55;
  color: var(--c-gray);
}
.sd-hero__price {
  font-size: 60rpx;
  line-height: 1.1;
  color: var(--c-primary);
}
.sd-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.sd-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: var(--r-pill);
  background: var(--c-primary-light);
  color: var(--c-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.sd-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 36rpx;
}
.sd-card__title {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
  color: var(--c-ink-strong);
}
.sd-flow,
.sd-copy {
  font-size: 28rpx;
  line-height: 1.6;
  color: #4E5969;
}

.sd-include {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.sd-include__item {
  display: flex;
  align-items: center;
  height: 70rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  background: var(--c-paper);
  color: var(--c-ink);
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.sd-promise {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 36rpx;
  border-radius: 40rpx;
  border: 1rpx solid #F0C48F;
  background: var(--c-clay-light);
  box-sizing: border-box;
}
.sd-promise__title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--c-clay-ink);
}
.sd-promise__text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #7A5A35;
}

.sd-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 104rpx;
  border-radius: var(--r-pill);
  background: var(--c-primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: var(--sd-action);
}
.sd-submit--hover {
  background: var(--c-primary-press);
}

.sk-a { height: 396rpx; border-radius: 40rpx; }
.sk-b { height: 300rpx; border-radius: 40rpx; }
.sk-c { height: 220rpx; border-radius: 40rpx; }
