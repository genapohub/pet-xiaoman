/* C012 收银台（对齐画布 47:281）· 1 画布 px = 2rpx */

.page { padding-bottom: 0; }

.cbody {
  display: flex;
  flex-direction: column;
  gap: 24rpx;                           /* 12px */
  padding: 0 40rpx;
  box-sizing: border-box;
}

.ccard {
  display: flex;
  flex-direction: column;
  gap: 16rpx;                           /* 8px */
  padding: 28rpx 36rpx;                 /* 上下 14px / 左右 18px */
  box-shadow: var(--sd-card);
}
.ccard__label {
  font-size: 26rpx;                     /* 13px */
  font-weight: 500;
  line-height: 1.4;
  color: var(--c-gray-mid);
}
.ccard__note {
  font-size: 24rpx;                     /* 12px */
  line-height: 1.6;
  color: var(--c-gray-mid);
}

/* 明细行：左标签右数值 */
.crow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.crow__l {
  flex: none;
  font-size: 28rpx;
  color: var(--c-ink);
}
.crow__v {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-ink-strong);
  text-align: right;
}

/* ===== 支付方式 =====
   选中 = 白底 + 松绿描边（画布 47:310）；未选中 = 纸感底无描边；
   不可选 = 降透明度 + 副文案给出原因（不做成死按钮） */
.mopt {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 20rpx 32rpx;
  border-radius: 24rpx;                 /* 12px */
  background: var(--c-paper);
  border: 2rpx solid #E9E1D4;
  box-sizing: border-box;
}
.mopt--hover { background: var(--c-primary-pale); }
.mopt--on {
  background: var(--c-card);
  border-color: var(--c-primary);
}
.mopt--off {
  background: #FAF7F0;
  border-color: #E9E1D4;
}
.mopt__main { flex: 1; min-width: 0; }
.mopt__name {
  font-size: 30rpx;                     /* 15px */
  font-weight: 500;
  line-height: 1.35;
  color: var(--c-ink-strong);
}
.mopt__desc {
  margin-top: 6rpx;
  font-size: 24rpx;                     /* 12px */
  line-height: 1.45;
  color: var(--c-gray-mid);
}
.mopt__tip {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #9B8A72;
}

/* 给固定费用条让位 */
.cspacer { height: 200rpx; }
