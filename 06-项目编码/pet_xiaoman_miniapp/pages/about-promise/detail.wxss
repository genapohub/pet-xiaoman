/* C-关于与承诺（对齐画布 58:520）· 1 画布 px = 2rpx */

.abody {
  display: flex;
  flex-direction: column;
  gap: 32rpx;                           /* 16px */
  padding: 0 40rpx var(--sp-6);
  box-sizing: border-box;
}

/* ===== 品牌 Intro（品牌色渐变，随门店换肤）===== */
.intro {
  display: flex;
  flex-direction: column;
  gap: 16rpx;                           /* 8px */
  padding: 36rpx;                       /* 18px */
  border-radius: 36rpx;                 /* 18px */
  background: linear-gradient(180deg, var(--c-primary), var(--c-primary-press));
}
.intro__brand {
  font-family: var(--font-serif);
  font-size: 40rpx;                     /* 20px */
  font-weight: 600;
  line-height: 1.3;
  color: #fff;
}
.intro__tag {
  font-size: 24rpx;                     /* 12px */
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.92);
}
.intro__proof {
  margin-top: 4rpx;
  font-size: 22rpx;                     /* 11px */
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.72);
}

/* ===== 三承诺速览 ===== */
.proofs {
  display: flex;
  gap: 24rpx;                           /* 12px */
}
.proof {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 26rpx 12rpx;
  background: var(--c-card);
  border: 1rpx solid var(--c-stroke);
  border-radius: 36rpx;
  box-sizing: border-box;
}
.proof__v {
  font-family: var(--font-serif);
  font-size: 32rpx;                     /* 16px */
  font-weight: 600;
  line-height: 1.2;
  color: var(--c-primary);
}
.proof__l {
  font-size: 22rpx;                     /* 11px */
  line-height: 1.4;
  color: var(--c-gray-mid);
  text-align: center;
}

/* ===== 承诺 / 流程 / 理念 三张卡 ===== */
.comm,
.flow,
.belief {
  display: flex;
  flex-direction: column;
  gap: 28rpx;                           /* 14px */
  padding: 36rpx;                       /* 18px —— 覆盖 .card 的 40rpx(20px)，对齐画布 58:534/58:539 的 18px 内边距 */
}

.comm__item,
.flow__item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.comm__ic { flex: none; width: 40rpx; height: 40rpx; }
.comm__body { flex: 1; min-width: 0; }
.comm__t {
  font-size: 28rpx;                     /* 14px */
  font-weight: 500;
  line-height: 1.4;
  color: var(--c-ink-strong);
}
.comm__d {
  margin-top: 6rpx;
  font-size: 24rpx;                     /* 12px */
  line-height: 1.6;
  color: var(--c-gray-mid);
}

/* 流程步骤号：等宽数字 + 松绿浅底圆角块 */
.flow__step {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: var(--c-primary-light);
  color: var(--c-primary);
  font-size: 24rpx;
  font-weight: 600;
}
.flow__body { flex: 1; min-width: 0; }
.flow__t {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
  color: var(--c-ink-strong);
}
.flow__d {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--c-gray-mid);
}

.belief__para {
  font-family: var(--font-serif);
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--c-ink);
}
.belief__li {
  position: relative;
  padding-left: 28rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--c-gray-mid);
}
.belief__li::before {
  content: "";
  position: absolute;
  left: 6rpx;
  top: 16rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--c-primary);
  opacity: 0.6;
}

/* ===== 文末轻 CTA（ghost 描边，不抢内容）===== */
.act {
  display: flex;
  gap: 24rpx;
}
.act__ghost {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;                        /* 44px 触控下限 */
  border-radius: var(--r-pill);
  background: var(--c-card);
  border: 1rpx solid var(--c-primary);
  color: var(--c-primary);
  font-size: 28rpx;
  line-height: 1;
}
.act__ghost--hover { background: var(--c-primary-light); }
