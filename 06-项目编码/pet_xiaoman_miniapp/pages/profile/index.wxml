<!-- C010 个人中心（对齐画布 2:545，我的一级 tab 页）
     结构：衬线页头（无返回）→ 品牌横幅（店名/标语/客户编号）→ 三组菜单 → 退出登录。
     一级页保留原生 tabBar；底部留 spacer 让位。
     本页补齐了原先缺失的「更多」分组（自检报告：底部 39% 空白）。 -->
<view class="page" style="{{brandStyle}}">

  <view class="nav" style="padding-top:{{nav.navTop}}px">
    <view class="nav__head" style="min-height:{{nav.headerH}}px">
      <view class="nav__titles">
        <view class="nav__title">我的</view>
      </view>
    </view>
  </view>

  <view class="pbody">

    <!-- 品牌横幅：反白标 + 店名 + 标语；门店无 logo 时用店名首字中性占位 -->
    <view class="banner">
      <view class="banner__logo">
        <image wx:if="{{theme.logoUrl}}" class="banner__img" src="{{theme.logoUrl}}" mode="aspectFit" />
        <view wx:else class="banner__mark">{{shopInitial}}</view>
      </view>
      <view class="banner__text">
        <view class="banner__name">{{theme.shopName}}</view>
        <view class="banner__slogan">{{theme.slogan || '爱意小满，不留遗憾'}}</view>
      </view>
      <view class="banner__no" wx:if="{{customerId}}">No.{{customerId}}</view>
    </view>

    <!-- 三组菜单 -->
    <view class="mgroups">
      <view class="mgroup" wx:for="{{groups}}" wx:key="key">
        <view class="mrow" wx:for="{{item.items}}" wx:for-item="it" wx:key="label"
          data-url="{{it.url}}" bindtap="go" hover-class="mrow--hover">
          <image class="mrow__ic" src="{{it.icon}}" mode="aspectFit" />
          <view class="mrow__label">{{it.label}}</view>
          <image class="mrow__chev" src="/assets/icons/chevron.png" mode="aspectFit" />
        </view>
      </view>
    </view>

    <!-- 在线客服：一期用门店电话兜底 -->
    <view class="mgroup">
      <view class="mrow" bindtap="callShop" hover-class="mrow--hover">
        <image class="mrow__ic" src="/assets/icons/phone.png" mode="aspectFit" />
        <view class="mrow__label">联系门店</view>
        <view class="mrow__meta">{{theme.contactPhone || '未配置'}}</view>
        <image class="mrow__chev" src="/assets/icons/chevron.png" mode="aspectFit" />
      </view>
    </view>

    <!-- 退出登录：仅在已登录时出现，红字表意（不用红色做促销） -->
    <view class="mgroup" wx:if="{{customerId}}">
      <view class="mrow mrow--danger" bindtap="logout" hover-class="mrow--hover">退出登录</view>
    </view>

    <view class="pfoot">宠小满 · 宠物善终服务</view>
  </view>

  <view class="pspacer"></view>
</view>
