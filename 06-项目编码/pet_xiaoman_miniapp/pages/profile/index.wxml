<view class="page" style="{{brandStyle}}">
  <!-- 品牌头部：主色底 + 反白标；门店有自有 logo 用图，没有则用店名首字占位 -->
  <view class="brand">
    <image wx:if="{{theme.logoUrl}}" class="brand__logo" src="{{theme.logoUrl}}" mode="aspectFit" />
    <view wx:else class="brand__logo brand__mark brandmark">{{shopInitial}}</view>
    <view class="brand__name">{{theme.shopName}}</view>
    <view class="brand__slogan" wx:if="{{theme.slogan}}">{{theme.slogan}}</view>
    <view class="brand__id">客户编号 {{customerId || "未注册"}}</view>
  </view>

  <view class="menu">
    <view class="row-link" wx:for="{{menus}}" wx:key="label"
      data-url="{{item.url}}" bindtap="go">
      <image class="icon-md" src="{{item.icon}}" mode="aspectFit" />
      <view class="row-link__label">{{item.label}}</view>
      <image class="icon-sm" src="/assets/icons/chevron.png" mode="aspectFit" />
    </view>
  </view>
</view>
