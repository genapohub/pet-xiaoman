<!-- C010 个人中心（对齐画布 2:545，我的一级 tab 页）
     结构：衬线页头（无返回）→ 用户卡 → 6 行菜单。
     一级页使用自定义胶囊 tabBar（「我的」激活）。 -->
<view class="page" style="{{brandStyle}}">

  <view class="nav" style="padding-top:{{nav.navTop}}px">
    <view class="nav__head" style="min-height:{{nav.headerH}}px">
      <view class="nav__titles">
        <view class="nav__title">我的</view>
      </view>
    </view>
  </view>

  <view class="pbody">

    <!-- 用户卡：头像首字 + 昵称 + 手机号 + 会员标签 -->
    <view class="banner">
      <view class="banner__avatar">
        <view class="banner__mark">{{profileInitial}}</view>
      </view>
      <view class="banner__text">
        <view class="banner__name">{{profileName}}</view>
        <view class="banner__phone">{{profilePhone}}</view>
        <view class="banner__tag">{{memberLabel}}</view>
      </view>
    </view>

    <view class="mgroup">
      <view class="mrow" wx:for="{{menus}}" wx:key="label"
        data-url="{{item.url}}" data-action="{{item.action}}" bindtap="onMenuTap" hover-class="mrow--hover">
        <image class="mrow__ic" src="{{item.icon}}" mode="aspectFit" />
        <view class="mrow__label">{{item.label}}</view>
        <image class="mrow__chev" src="{{item.chevron}}" mode="aspectFit" />
      </view>
    </view>
  </view>

  <view class="pspacer"></view>
</view>
