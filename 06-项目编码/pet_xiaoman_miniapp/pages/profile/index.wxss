.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx var(--sp-4) 92rpx;
  background:
    radial-gradient(circle at 16% 0%, rgba(217, 164, 104, 0.20) 0, rgba(217, 164, 104, 0) 180rpx),
    linear-gradient(180deg, var(--c-primary) 0%, var(--c-primary-press) 100%);
  border-bottom-left-radius: 42rpx;
  border-bottom-right-radius: 42rpx;
}
.brand__logo {
  width: 128rpx;
  height: 128rpx;
}
/* 未配 logo 时的中性占位标：尺寸与 logo 一致，字号按视觉重心调 */
.brand__mark {
  font-size: 60rpx;
}
.brand__name {
  margin-top: var(--sp-3);
  font-size: var(--fs-lg);
  font-weight: 600;
  color: #fff;
  letter-spacing: 0;
}
.brand__slogan {
  margin-top: var(--sp-1);
  color: rgba(255, 255, 255, 0.68);
  font-size: var(--fs-sm);
}
.brand__id {
  margin-top: var(--sp-3);
  padding: 8rpx 18rpx;
  font-size: var(--fs-sm);
  color: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: var(--r-pill);
}

.menu {
  margin: -44rpx var(--sp-4) 0;
  border-radius: var(--r-lg);
  overflow: hidden;
  box-shadow: var(--sd-card);
  border: 1rpx solid rgba(61, 92, 87, 0.06);
}
.menu .row-link + .row-link {
  border-top: 1rpx solid var(--c-divider);
}
