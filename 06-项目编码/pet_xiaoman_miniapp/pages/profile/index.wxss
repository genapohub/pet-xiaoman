/* C010 个人中心（对齐画布 2:545）· 1 画布 px = 2rpx */

.nav__title { font-size: 40rpx; }

.pbody {
  display: flex;
  flex-direction: column;
  gap: 32rpx;                           /* 16px */
  padding: 0 40rpx var(--sp-6);
  box-sizing: border-box;
}

/* ===== 品牌横幅 ===== */
.banner {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx;                       /* 18px */
  border-radius: 36rpx;
  background: linear-gradient(180deg, var(--c-primary), #6FA69E);
  box-sizing: border-box;
}
.banner__avatar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.92);
  overflow: hidden;
}
.banner__mark {
  font-family: var(--font-serif);
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1;
  color: var(--c-primary);
}
.banner__text { flex: 1; min-width: 0; }
.banner__name {
  font-size: 32rpx;                     /* 16px */
  font-weight: 500;
  line-height: 1.35;
  color: #fff;
}
.banner__phone {
  margin-top: 2rpx;
  font-size: 24rpx;                     /* 12px */
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.82);
}
.banner__tag {
  display: inline-block;
  margin-top: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 22rpx;
  line-height: 1.2;
}

/* ===== 菜单分组 ===== */
.mgroup {
  background: var(--c-card);
  border: 1rpx solid var(--c-stroke);
  border-radius: 36rpx;
  overflow: hidden;
  box-sizing: border-box;
}
.mrow {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 96rpx;                    /* 48px，满足 44px 触控下限 */
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--c-divider);
  box-sizing: border-box;
}
.mrow:last-child { border-bottom: none; }
.mrow--hover { background: var(--c-primary-pale); }
.mrow__ic { flex: none; width: 44rpx; height: 44rpx; }
.mrow__label {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;                     /* 14px */
  line-height: 1.4;
  color: var(--c-ink);
}
.mrow__meta {
  flex: none;
  font-size: 24rpx;
  color: var(--c-gray);
}
.mrow__chev { flex: none; width: 28rpx; height: 28rpx; }

/* 给自定义胶囊 tabBar 让位 */
.pspacer { height: 180rpx; }
