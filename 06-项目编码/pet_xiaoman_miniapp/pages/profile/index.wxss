/* C010 个人中心（对齐画布 2:545）· 1 画布 px = 2rpx */

.pbody {
  display: flex;
  flex-direction: column;
  gap: 32rpx;                           /* 16px */
  padding: 0 40rpx var(--sp-6);
  box-sizing: border-box;
}

/* ===== 品牌横幅 ===== */
.banner {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx;                       /* 18px */
  border-radius: 36rpx;
  background: linear-gradient(180deg, var(--c-primary), var(--c-primary-press));
  box-sizing: border-box;
}
.banner__logo {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.16);
  overflow: hidden;
}
.banner__img { width: 96rpx; height: 96rpx; }
.banner__mark {
  font-family: var(--font-serif);
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1;
  color: #fff;
}
.banner__text { flex: 1; min-width: 0; }
.banner__name {
  font-family: var(--font-serif);
  font-size: 40rpx;                     /* 20px */
  font-weight: 600;
  line-height: 1.25;
  color: #fff;
}
.banner__slogan {
  margin-top: 6rpx;
  font-size: 24rpx;                     /* 12px */
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.82);
}
.banner__no {
  flex: none;
  align-self: flex-start;
  font-family: var(--font-num);
  font-size: 22rpx;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.72);
}

/* ===== 菜单分组 ===== */
.mgroups {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}
.mgroup {
  background: var(--c-card);
  border: 1rpx solid var(--c-stroke);
  border-radius: 36rpx;
  overflow: hidden;
  box-sizing: border-box;
}
.mrow {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 96rpx;                    /* 48px，满足 44px 触控下限 */
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--c-divider);
  box-sizing: border-box;
}
.mrow:last-child { border-bottom: none; }
.mrow--hover { background: var(--c-primary-pale); }
.mrow__ic { flex: none; width: 40rpx; height: 40rpx; }
.mrow__label {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;                     /* 14px */
  line-height: 1.4;
  color: var(--c-ink);
}
.mrow__meta {
  flex: none;
  font-size: 24rpx;
  color: var(--c-gray);
}
.mrow__chev { flex: none; width: 28rpx; height: 28rpx; }

/* 退出登录：整行居中、红字，与普通菜单行区分 */
.mrow--danger {
  justify-content: center;
  padding: 32rpx;
  font-size: 28rpx;
  color: var(--c-error);
}

.pfoot {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--c-gray-light);
  text-align: center;
}

/* 给原生 tabBar 让位 */
.pspacer { height: 180rpx; }
