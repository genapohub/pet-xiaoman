<!-- C-资料编辑 profile-detail（对齐画布 58:494，我的 · 二级页）
     结构：返回 + 页头「资料编辑」→ 基础资料卡（头像/昵称/手机号）→ 其他信息（跳转入口）
           → 底部固定「保存修改」。
     数据落点 `PUT /api/c/auth/me`。画布上的「收货地址」未实现：纪念品当前是到店自取口径，
     Customer 也无地址字段——等口径定稿再加字段与迁移，先不做空壳输入框。 -->
<view class="page" style="{{brandStyle}}">

  <view class="nav nav--sub" style="padding-top:{{nav.navTop}}px">
    <view class="nav__head" style="min-height:{{nav.headerH}}px">
      <view class="nav__back" bindtap="goBack" hover-class="nav__back--hover">
        <view class="nav__back-ic"></view>
      </view>
      <view class="nav__titles">
        <view class="nav__title">资料编辑</view>
      </view>
    </view>
  </view>

  <view class="dbody">

    <!-- 基础资料 -->
    <view class="card dcard">
      <view class="dcard__label">基础资料</view>

      <view class="drow">
        <view class="drow__l">头像</view>
        <view class="drow__avatar">{{initial}}</view>
      </view>

      <view class="drow drow--input">
        <view class="drow__l">昵称</view>
        <input class="drow__input" placeholder="怎么称呼您" placeholder-class="dph"
          value="{{form.nickname}}" data-field="nickname" bindinput="onInput" maxlength="50" />
      </view>

      <view class="drow drow--input">
        <view class="drow__l">手机号</view>
        <input class="drow__input" type="number" maxlength="11" placeholder="11 位手机号"
          placeholder-class="dph" value="{{form.phone}}" data-field="phone" bindinput="onInput" />
      </view>

      <view class="dcard__note">手机号用于接收服务进度通知与门店联系，请填写可接通的号码。</view>
    </view>

    <!-- 其他信息：全部是真实可达的页面，不放没有落点的假入口 -->
    <view class="card dcard dcard--list">
      <view class="dlink" wx:for="{{links}}" wx:key="label" data-url="{{item.url}}"
        bindtap="goLink" hover-class="dlink--hover">
        <image class="dlink__ic" src="{{item.icon}}" mode="aspectFit" />
        <view class="dlink__label">{{item.label}}</view>
        <image class="dlink__chev" src="/assets/icons/chevron.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <view class="dspacer"></view>

  <!-- 裸保存按钮（对齐画布 58:576：374×52 @ y824，无底栏底色，直接浮于纸感底） -->
  <view class="save-btn {{submitting ? 'save-btn--busy' : ''}}"
    bindtap="save" hover-class="save-btn--hover">{{submitting ? '保存中…' : '保存修改'}}</view>
</view>
