.profile-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--sp-6) var(--sp-4) 86rpx;
  color: #fff;
  background: var(--c-primary);
  border-bottom-left-radius: 42rpx;
  border-bottom-right-radius: 42rpx;
}
.profile-head__avatar {
  width: 112rpx;
  height: 112rpx;
  font-size: var(--fs-xl);
}
.profile-head__name {
  margin-top: var(--sp-3);
  font-size: var(--fs-lg);
  font-weight: 600;
}
.profile-head__sub {
  margin-top: var(--sp-1);
  color: rgba(255, 255, 255, 0.76);
  font-size: var(--fs-sm);
}
.profile-head__chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}
.profile-head__chips text {
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: var(--r-pill);
  color: rgba(255, 255, 255, 0.88);
  font-size: var(--fs-xs);
}
.safe-note {
  display: flex;
  gap: var(--sp-2);
  align-items: flex-start;
  margin: -42rpx var(--sp-4) var(--sp-3);
  padding: var(--sp-3);
  position: relative;
  z-index: 1;
  border: 1rpx solid rgba(61, 92, 87, 0.08);
  border-radius: var(--r-lg);
  background: var(--c-card-warm);
  box-shadow: var(--sd-card);
}
.safe-note image {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}
.safe-note__title {
  color: var(--c-ink);
  font-size: var(--fs-sm);
  font-weight: 600;
}
.safe-note__text {
  margin-top: 4rpx;
  color: var(--c-gray);
  font-size: var(--fs-xs);
  line-height: 1.6;
}
.info-card {
  margin: var(--sp-3) var(--sp-4);
}
.section-title {
  margin-bottom: var(--sp-2);
  color: var(--c-ink);
  font-size: var(--fs-base);
  font-weight: 600;
}
.info-row {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-3);
  padding: var(--sp-2) 0;
  border-top: 1rpx solid var(--c-divider);
}
.info-row:nth-of-type(2) {
  border-top: none;
}
.info-row__key {
  width: 144rpx;
  flex-shrink: 0;
  color: var(--c-gray);
  font-size: var(--fs-sm);
}
.info-row__value {
  flex: 1;
  color: var(--c-ink);
  font-size: var(--fs-base);
  line-height: var(--lh-body);
  word-break: break-all;
}
.contact-btn {
  margin-top: var(--sp-3);
}
