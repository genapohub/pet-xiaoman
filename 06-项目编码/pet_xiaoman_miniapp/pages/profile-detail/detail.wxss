/* C-资料编辑 profile-detail（对齐画布 58:494）· 1 画布 px = 2rpx */

.page { padding-bottom: 0; }

.dbody {
  display: flex;
  flex-direction: column;
  gap: 24rpx;                           /* 12px */
  padding: 0 40rpx;
  box-sizing: border-box;
}

.dcard {
  display: flex;
  flex-direction: column;
  gap: 16rpx;                           /* 8px */
  padding: 28rpx 36rpx;
}
.dcard--list { padding: 0; gap: 0; overflow: hidden; }
.dcard__label {
  font-size: 26rpx;                     /* 13px */
  font-weight: 500;
  line-height: 1.4;
  color: var(--c-gray-mid);
}
.dcard__note {
  font-size: 22rpx;                     /* 11px */
  line-height: 1.6;
  color: var(--c-gray-light);
}

/* 表单行：左标签定宽，右侧值/输入撑满 */
.drow {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;                    /* 44px 触控下限 */
  border-bottom: 1rpx solid var(--c-divider);
  box-sizing: border-box;
}
.drow:last-of-type { border-bottom: none; }
.drow__l {
  flex: none;
  width: 120rpx;                        /* 标签列对齐，避免右侧起始位参差 */
  font-size: 28rpx;
  color: var(--c-ink);
}
.drow__input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--c-ink);
  text-align: right;
}
.dph { color: var(--c-gray-light); }
/* 头像：中立色圆盘 + 昵称首字（与宠物档案同一套占位逻辑） */
.drow__avatar {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.drow__avatar {
  width: 80rpx;
  height: 80rpx;
  flex: none;
  margin-left: auto;
  border-radius: var(--r-pill);
  background: var(--c-paper-deep);
  font-family: var(--font-serif);
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1;
  color: var(--c-gray-mid);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 跳转行 */
.dlink {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 96rpx;
  padding: 24rpx 36rpx;
  border-bottom: 1rpx solid var(--c-divider);
  box-sizing: border-box;
}
.dlink:last-child { border-bottom: none; }
.dlink--hover { background: var(--c-primary-pale); }
.dlink__ic { flex: none; width: 40rpx; height: 40rpx; }
.dlink__label {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--c-ink);
}
.dlink__chev { flex: none; width: 28rpx; height: 28rpx; }

/* 给固定底栏让位 */
.dspacer { height: 144rpx; }             /* 裸按钮 104rpx + bottom 40rpx = 144rpx（72px）让位 */

/* 裸保存按钮（对齐画布 58:576：374×52 @ y824，无底栏底色，直接浮于纸感底） */
.save-btn {
  position: fixed;
  left: 40rpx;                          /* 20px */
  right: 40rpx;
  bottom: 40rpx;                        /* 20px */
  height: 104rpx;                       /* 52px */
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-pill);
  background: var(--c-primary);
  color: #fff;
  font-size: 30rpx;                     /* 15px */
  font-weight: 500;
  line-height: 1;
  box-sizing: border-box;
}
.save-btn--hover { background: var(--c-primary-press); }
.save-btn--busy { background: var(--c-primary-disabled); }
