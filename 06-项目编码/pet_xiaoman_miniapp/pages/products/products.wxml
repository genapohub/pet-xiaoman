<!-- C007 纪念品（对齐画布 2:367，纪念品一级 tab 页）
     结构：衬线页头（无返回 + 情绪副题）→ 搜索胶囊
           → 双列网格（图 / 名称 / 价格）→ 空态。
     一级页使用自定义胶囊 tabBar（「纪念品」激活），卡片点进详情。 -->
<view class="page" style="{{brandStyle}}">

  <view class="nav" style="padding-top:{{nav.navTop}}px">
    <view class="nav__head" style="min-height:{{nav.headerH}}px">
      <view class="nav__titles">
        <view class="nav__title">纪念品</view>
        <view class="nav__sub">把温柔留下，陪您久一点</view>
      </view>
    </view>
  </view>

  <view class="swrap">
    <view class="search">
      <image class="search__ic" src="{{searchIcon}}" mode="aspectFit" />
      <input
        class="search__input"
        placeholder="搜索纪念品"
        placeholder-class="search__ph"
        value="{{keyword}}"
        bindinput="onSearch"
        confirm-type="search"
      />
    </view>
  </view>

  <view class="mgrid">
    <view class="mcard" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail" hover-class="mcard--hover">
      <view class="mcard__imgwrap">
        <image class="mcard__img" src="{{item.image}}" mode="aspectFill" />
      </view>
      <view class="mcard__body">
        <view class="mcard__name">{{item.name}}</view>
        <view class="mcard__price num">¥{{item.priceText}}</view>
      </view>
    </view>

    <view wx:if="{{!products.length}}" class="state mgrid__empty">
      <view class="state__disc">
        <image class="state__icon" src="/assets/ardot/icons/2_128-20260922_083300124.png" mode="aspectFit" />
      </view>
      <view class="state__title">没有找到相关纪念品</view>
      <view class="state__text">换个关键词试试，或联系门店咨询</view>
      <view class="state__cta" bindtap="callShop" hover-class="state__cta--hover">联系门店</view>
    </view>
  </view>

  <view class="mspacer"></view>
</view>
