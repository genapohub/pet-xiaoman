/* C007 纪念品（对齐画布 2:367）· 1 画布 px = 2rpx */

.nav__title { font-size: 40rpx; }

/* ===== 搜索胶囊 ===== */
.swrap {
  padding: 16rpx 40rpx 0;               /* 画布 top 8px */
  box-sizing: border-box;
}
.search {
  display: flex;
  align-items: center;
  gap: 16rpx;                           /* 8px */
  height: 76rpx;                        /* 20px padding + 18px icon ≈ 38px 高 */
  padding: 0 28rpx;                     /* 14px */
  border-radius: var(--r-pill);
  background: var(--c-card);
  border: 1rpx solid var(--c-stroke);
  box-sizing: border-box;
}
.search__ic {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  opacity: 0.5;
}
.search__input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;                     /* 13px */
  color: var(--c-ink);
}
.search__ph { color: var(--c-gray-mid); }

/* ===== 双列网格 =====
   用 flex-wrap + 定宽（而非 grid）——小程序 grid 在旧基础库支持不稳，
   定宽两列 = (750−80−24)/2 = 323rpx，等价画布两列各 181px。 */
.mgrid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;                           /* 12px */
  padding: 16rpx 40rpx 0;
  box-sizing: border-box;
}
.mcard {
  width: 323rpx;
  display: flex;
  flex-direction: column;
  background: var(--c-card);
  border: 1rpx solid var(--c-stroke);
  border-radius: 32rpx;                 /* 16px */
  overflow: hidden;
  box-sizing: border-box;
}
.mcard__imgwrap {
  width: 100%;
  height: 250rpx;                       /* 画布图片区 181×140，按小程序宽度等比落地 */
  background: var(--c-paper);
}
.mcard__img { width: 100%; height: 250rpx; display: block; }
.mcard__body {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx 24rpx 24rpx;
  box-sizing: border-box;
}
.mcard__name {
  font-size: 28rpx;                     /* 14px */
  font-weight: 500;
  line-height: 1.4;
  color: var(--c-ink-strong);
}
.mcard__price {
  font-size: 34rpx;                     /* 17px */
  font-weight: 600;
  color: var(--c-primary);
}

/* 空态占满整行 */
.mgrid__empty { width: 100%; padding: 120rpx 40rpx; }

/* 给自定义胶囊 tabBar 让位 */
.mspacer { height: 180rpx; }
