<view class="page">
  <view class="form-head">
    <view class="form-head__title">预约服务</view>
    <view class="form-head__desc">提交后门店 30 分钟内电话确认，支付方式可稍后再定。</view>
  </view>

  <view class="card">
    <view class="label">
      <image class="label__icon" src="/assets/icons/tab-gift.png" mode="aspectFit" />
      <text>选择套餐</text>
    </view>
    <picker range="{{packages}}" range-key="name" value="{{pkgIndex}}" bindchange="onPkgChange">
      <view class="picker">
        <text>{{currentPackage ? currentPackage.name : "请选择套餐"}} · ¥{{currentPackage ? currentPackage.price : "--"}}</text>
        <image class="picker__arrow" src="/assets/icons/chevron.png" mode="aspectFit" />
      </view>
    </picker>
  </view>

  <view class="card">
    <view class="label">
      <image class="label__icon" src="/assets/icons/paw.png" mode="aspectFit" />
      <text>宠物信息</text>
    </view>
    <input placeholder="宠物名字（必填）" value="{{form.pet_name}}" data-field="pet_name" bindinput="onInput" />
    <view class="species-row">
      <text>种类</text>
      <button size="mini" class="species-btn" bindtap="onSpecies">{{form.species}}</button>
    </view>
    <input type="digit" placeholder="体重 kg（选填，影响火化计价）" value="{{form.weight}}" data-field="weight" bindinput="onInput" />
  </view>

  <view class="card">
    <view class="label">
      <image class="label__icon" src="/assets/icons/clock.png" mode="aspectFit" />
      <text>服务安排</text>
    </view>
    <picker mode="date" bindchange="onTime">
      <view class="picker">
        <text class="{{expectTime ? '' : 'is-placeholder'}}">{{expectTime || "选择期望服务日期"}}</text>
        <image class="picker__arrow" src="/assets/icons/chevron.png" mode="aspectFit" />
      </view>
    </picker>
    <input placeholder="接送地址（到店自送可不填）" value="{{form.address}}" data-field="address" bindinput="onInput" />
  </view>

  <view class="notice">
    <image class="notice__icon" src="/assets/icons/shield-primary.png" mode="aspectFit" />
    <text>明码标价 · 提交后门店 30 分钟内电话确认 · 到店付款</text>
  </view>

  <view class="summary-bar">
    <view>
      <view class="summary-bar__label">预计费用</view>
      <view class="summary-bar__price">¥{{currentPackage ? currentPackage.price : "--"}}</view>
    </view>
    <button class="btn-primary submit" disabled="{{submitting}}" bindtap="submit">{{submitting ? "提交中..." : "提交预约"}}</button>
  </view>
</view>
