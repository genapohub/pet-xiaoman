.page {
  padding-bottom: 336rpx;
}

.form-head {
  padding: var(--sp-6) var(--sp-4) var(--sp-4);
  color: #fff;
  background: linear-gradient(180deg, var(--c-primary) 0%, var(--c-primary-press) 100%);
  border-bottom-left-radius: 36rpx;
  border-bottom-right-radius: 36rpx;
}
.form-head__title {
  font-size: var(--fs-xl);
  font-weight: 600;
  line-height: var(--lh-title);
}
.form-head__desc {
  margin-top: var(--sp-2);
  color: rgba(255, 255, 255, 0.72);
  font-size: var(--fs-sm);
  line-height: 1.7;
}

.card {
  margin: var(--sp-3) var(--sp-4);
  padding: var(--sp-4);
}
.form-head + .card {
  margin-top: -20rpx;
}

.label {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  margin-bottom: var(--sp-3);
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--c-ink);
}
.label__icon {
  width: 32rpx;
  height: 32rpx;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: var(--h-touch);
  padding: 0 var(--sp-3);
  background: transparent;
  border-bottom: 1rpx solid var(--c-divider);
  border-radius: 0;
  font-size: var(--fs-base);
  color: var(--c-ink);
}
.picker__arrow {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.7;
}
.is-placeholder { color: var(--c-gray-light); }

.form-input {
  height: var(--h-touch);
  padding: 0 var(--sp-3);
  margin-top: var(--sp-2);
  background: transparent;
  border-bottom: 1rpx solid var(--c-divider);
  border-radius: 0;
  font-size: var(--fs-base);
  color: var(--c-ink);
}

.location-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-1);
  height: 72rpx;
  margin: var(--sp-3) 0 var(--sp-1);
  padding: 0 var(--sp-3);
  background: var(--c-primary-light);
  color: var(--c-primary-deep);
  font-size: var(--fs-sm);
  border-radius: var(--r-md);
}
.location-btn::after { border: none; }
.location-btn.is-disabled {
  background: #F2F3F5;
  color: var(--c-gray);
}
.location-btn__icon {
  width: 32rpx;
  height: 32rpx;
}

.species-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  gap: var(--sp-3);
  padding: 12rpx var(--sp-3);
  margin-top: var(--sp-3);
  background: transparent;
  border-bottom: 1rpx solid var(--c-divider);
  border-radius: 0;
  font-size: var(--fs-base);
  color: var(--c-ink);
  box-sizing: border-box;
}
.species-field__label {
  flex-shrink: 0;
  font-weight: 500;
}
.species-segment {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  width: 288rpx;
  padding: 6rpx;
  border: 1rpx solid rgba(91, 140, 133, 0.14);
  border-radius: 24rpx;
  background: var(--c-primary-pale);
  box-sizing: border-box;
}
.species-option {
  min-height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border-radius: 18rpx;
  color: var(--c-gray);
  transition: background 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
}
.species-option.is-active {
  background: var(--c-primary);
  color: #fff;
  box-shadow: 0 10rpx 24rpx rgba(61, 92, 87, 0.18);
}
.species-option__name {
  font-size: var(--fs-base);
  font-weight: 600;
  line-height: 1;
}
.species-option__hint {
  font-size: 22rpx;
  line-height: 1;
  opacity: 0.82;
}

.summary-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: var(--sp-2);
  padding: var(--sp-3) var(--sp-4) calc(var(--sp-3) + env(safe-area-inset-bottom));
  background: rgba(255, 253, 248, 0.98);
  border-top: 1rpx solid rgba(61, 92, 87, 0.08);
  box-shadow: 0 -8rpx 28rpx rgba(61, 92, 87, 0.08);
}
.summary-bar__notice {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  min-height: 48rpx;
  padding: 0 var(--sp-2);
  color: #A9762F;
  font-size: var(--fs-xs);
  line-height: 1.4;
}
.summary-bar__notice-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}
.summary-bar__main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-3);
}
.summary-bar__label {
  color: var(--c-gray);
  font-size: var(--fs-xs);
}
.summary-bar__price {
  margin-top: 2rpx;
  color: var(--c-primary);
  font-size: 44rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.submit {
  width: 396rpx;
  margin: 0;
}
