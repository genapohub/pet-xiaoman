/* C004 预约下单（对齐画布 2:219）· 1 画布 px = 2rpx */

.page { padding-bottom: 0; }

.fbody {
  display: flex;
  flex-direction: column;
  gap: 24rpx;                           /* 12px */
  padding: 0 40rpx;                     /* 20px */
  box-sizing: border-box;
}

.fcard {
  display: flex;
  flex-direction: column;
  gap: 16rpx;                           /* 8px */
  padding: 28rpx 36rpx;                 /* 上下 14px / 左右 18px */
  box-shadow: var(--sd-card);
}
.fcard__label {
  font-size: 26rpx;                     /* 13px */
  font-weight: 500;
  line-height: 1.4;
  color: var(--c-gray-mid);
}
.fcard__note {
  font-size: 22rpx;                     /* 11px */
  line-height: 1.5;
  color: var(--c-gray-light);
}

/* ===== 已选套餐（可点整行切换）===== */
.pkgrow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 8rpx 0;
  box-sizing: border-box;
}
.pkgrow--hover { background: var(--c-primary-pale); }
.pkgrow__name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;                     /* 16px */
  font-weight: 500;
  line-height: 1.35;
  color: var(--c-ink-strong);
}
.pkgrow__price {
  flex: none;
  font-size: 40rpx;                     /* 20px */
  font-weight: 600;
  color: var(--c-primary);
}

/* ===== 附加服务多选行 ===== */
.arow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 44rpx;
  box-sizing: border-box;
}
.arow--hover { opacity: 0.72; }
.arow__name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  line-height: 1.4;
  color: var(--c-ink);
}
.arow__price {
  flex: none;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--c-primary);
}

/* ===== 输入类字段（纸感底 + 12rpx 圆角 + 高 52px）===== */
.finput {
  box-sizing: border-box;
  width: 100%;
  height: 104rpx;                       /* 52px */
  padding: 0 32rpx;
  border-radius: 24rpx;                 /* 12px */
  background: var(--c-paper);
  font-size: 30rpx;                     /* 15px */
  color: var(--c-ink);
}
.finput--row {
  background: var(--c-paper);
}
.fph { color: var(--c-gray); }
.finput--row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.finput__ic { flex: none; width: 40rpx; height: 40rpx; }
.finput__ph {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: var(--c-gray);
}
.finput__val {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: var(--c-ink);
}
.finput__inner {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: var(--c-ink);
}
.finput__inner--ro { color: var(--c-ink); }
.finput__act {
  flex: none;
  font-size: 26rpx;
  color: var(--c-primary);
}

/* 物种选择胶囊：选中=松绿实色白字；未选中=白底描边灰字 */
.sprow {
  display: flex;
  gap: 20rpx;                           /* 10px */
}
.spill {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;                        /* 40px */
  padding: 0 20rpx;
  border-radius: var(--r-pill);
  background: var(--c-card);
  border: 1rpx solid var(--c-stroke);
  color: var(--c-gray-mid);
  font-size: 28rpx;
  line-height: 1;
}
.spill--on {
  background: var(--c-primary);
  border-color: var(--c-primary);
  color: #fff;
  font-weight: 500;
}

/* 底部费用条样式（.feebar*）已收口到 app.wxss 共用 */

/* 给固定费用条让位 */
.fspacer { height: 200rpx; }
