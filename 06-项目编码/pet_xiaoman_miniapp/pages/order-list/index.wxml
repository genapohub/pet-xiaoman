<view class="page" style="{{brandStyle}}">
  <view class="orders-head">
    <view class="orders-head__title">我的订单</view>
    <view class="orders-head__desc">服务进度、费用与影像记录都会同步到这里。</view>
  </view>

  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="*this" class="tab {{active === item ? 'on' : ''}}"
      data-tab="{{item}}" bindtap="switchTab">{{item}}</view>
  </view>

  <!-- 加载：骨架屏（比「加载中...」更能减少等待焦虑） -->
  <block wx:if="{{loading}}">
    <view class="card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
      <view class="skeleton sk-line sk-line--lg"></view>
      <view class="skeleton sk-line sk-line--sm"></view>
    </view>
  </block>

  <block wx:else>
    <block wx:for="{{orders}}" wx:key="order_no">
      <view class="card"
        wx:if="{{active === '全部' || (active === '已完成' ? item.status === '已完成' : item.status !== '已完成' && item.status !== '已取消')}}"
        data-no="{{item.order_no}}" bindtap="goDetail">
        <view class="row">
          <text class="no">{{item.order_no}}</text>
          <text class="tag {{statusClass[item.status] || 'tag--muted'}}">{{item.status}}</text>
        </view>
        <view class="row">
          <text class="price">¥{{item.amount_text}}</text>
          <text class="time">{{item.expect_text}}</text>
        </view>
      </view>
    </block>

    <!-- 空态：告诉用户「为什么空」和「下一步做什么」 -->
    <view wx:if="{{!orders.length}}" class="state state--card">
      <image class="state__icon" src="/assets/icons/tab-order.png" mode="aspectFit" />
      <view class="state__text">还没有订单</view>
      <view class="state__hint">预约后可以在这里查看服务进度</view>
    </view>
  </block>

  <button class="btn-primary go" bindtap="goCreate">去预约</button>
</view>
