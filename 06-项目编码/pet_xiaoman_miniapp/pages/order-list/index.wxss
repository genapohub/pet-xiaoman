/* C005 我的订单（对齐画布 2:264）· 1 画布 px = 2rpx */

/* ===== 状态筛选 ===== */
.filters {
  display: flex;
  align-items: center;
  gap: 20rpx;                           /* 10px */
  padding: 40rpx;                       /* 20px */
  box-sizing: border-box;
}
.fpill {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;                        /* 34px */
  padding: 0 32rpx;                     /* 16px */
  border-radius: var(--r-pill);
  background: var(--c-card);
  border: 1rpx solid var(--c-stroke);
  color: var(--c-gray-mid);
  font-size: 26rpx;                     /* 13px */
  line-height: 1;
}
.fpill--on {
  background: var(--c-primary);
  border-color: var(--c-primary);
  color: #fff;
  font-weight: 500;
}

/* ===== 订单卡列表 ===== */
.olist {
  display: flex;
  flex-direction: column;
  gap: 32rpx;                           /* 16px */
  padding: 0 40rpx;
  box-sizing: border-box;
}
.ocard {
  display: flex;
  flex-direction: column;
  gap: 20rpx;                           /* 10px */
  padding: 32rpx;                       /* 16px */
  background: var(--c-card);
  border: 1rpx solid var(--c-stroke);
  border-radius: 36rpx;                 /* 18px */
  box-sizing: border-box;
}
.ocard--hover { background: var(--c-primary-pale); }
.ocard__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.ocard__no {
  flex: 1;
  min-width: 0;
  font-family: var(--font-num);
  font-size: 28rpx;                     /* 14px */
  font-weight: 600;
  color: var(--c-ink-strong);
}
.ocard__mid {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.ocard__svc {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;                     /* 14px */
  line-height: 1.4;
  color: var(--c-ink);
}
.ocard__amt {
  flex: none;
  font-size: 36rpx;                     /* 18px */
  font-weight: 600;
  color: var(--c-primary);
}
/* 终态订单金额降为中性灰：已完成/已取消不该继续抢视觉 */
.ocard__amt--done { color: var(--c-gray-mid); }
.ocard__time {
  font-size: 24rpx;                     /* 12px */
  line-height: 1.45;
  color: var(--c-gray);
}

/* 空态：状态屏居中（无 tabBar，body 内即整屏可视区） */
.olist .state { padding: 120rpx 40rpx; }

/* ===== 骨架 ===== */
.sk-a { height: 28rpx; width: 52%; }
.sk-b { height: 36rpx; width: 68%; }
.sk-c { height: 24rpx; width: 44%; }

/* 给固定底栏让位（bar 144rpx + 呼吸） */
.olist-spacer { height: 220rpx; }
